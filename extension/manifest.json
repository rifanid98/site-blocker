{
  "manifest_version": 3,
  "name": "SiteBlocker",
  "version": "0.2.0",
  "key": "",
  "description": "Blocks websites and keywords you list, with path-level exceptions. Optionally synced with the SiteBlocker Windows app.",
  "permissions": ["webNavigation", "scripting", "storage", "alarms", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SiteBlocker: focus mode",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
